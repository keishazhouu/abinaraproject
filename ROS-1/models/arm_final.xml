<mujoco model="abinara">
    <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"/>
    <compiler angle="radian"/>

    <default>
        <joint damping="2"/>
        <geom rgba="0.75 0.75 0.67 1" contype="0" conaffinity="1"/>
    </default>

    <worldbody>
        <light diffuse="1 1 1" pos="0 0 2" dir="0 0 -1"/>
        <geom type="plane" size="1 1 0.01" contype="1" conaffinity="0" rgba="0.9 0.9 0.9 1"/>

        <geom size="0.3 0.025" pos="0 0 0.025" type="cylinder"/>
        <geom size="0.075 0.075 0.025" pos="0 0 0.075" type="box"/>
        <body name="torso" pos="0 0 0.1">
            <inertial pos="0 0 0.2" mass="1.5" diaginertia="0.02146 0.02146 0.00125"/>
            <joint name="hip" pos="0 0 0" axis="0 0 1"/>
            <geom size="0.055 0.2" pos="0 0 0.2" type="cylinder"/>
            <body name="upper_arm" pos="0 0 0.375" quat="0.877583 0 0.479426 0">
                <inertial pos="0 0 0.15" mass="1.25" diaginertia="0.01396 0.01396 0.00125"/>
                <joint name="shoulder" pos="0 0 0" axis="0 1 0" range="-1.5708 0.6981" actuatorfrcrange="-30 30"/>
                <geom size="0.04 0.15" pos="0 0 0.15" type="cylinder"/>
                <body name="lower_arm" pos="-0.0175 0 0.275" quat="0.839192 0 0.543835 0">
                    <inertial pos="0 0 0.1" mass="1" diaginertia="0.01396 0.01396 0.00125"/>
                    <joint name="elbow" pos="0 0 0" axis="0 1 0" range="-2.25 1" actuatorfrcrange="-30 30"/>
                    <geom size="0.03 0.1" pos="0 0 0.1" type="cylinder"/>
                    <body name="hand" pos="0 0 0.2">
                        <inertial pos="0 0 0.025" mass="0.2" diaginertia="0.0001 0.0001 0.0001"/>
                        <joint name="wrist" pos="0 0 0" axis="0 1 0" range="-1.5708 1.5708" actuatorfrcrange="-30 30"/>
                        <geom size="0.03 0.03 0.025" pos="0 0 0.025" type="box"/>
                        <body name="finger_left" pos="0 0.01 0.05" quat="0.995004 -0.0998334 0 0">
                            <inertial pos="0 -0.00292064 0.029408" quat="0.995004 0.0998334 0 0" mass="0.2" diaginertia="0.000151224 0.000147198 1.00259e-05"/>
                            <joint name="left" damping="0.01" pos="0 0 0" axis="1 0 0" range="-0.5 0.085" actuatorfrcrange="-5 5"/>
                            <geom size="0.005 0.015" pos="0 0 0.015" type="cylinder"/>
                            <geom size="0.005 0.015" pos="0 -0.00584128 0.0438159" quat="0.980067 0.198669 0 0" type="cylinder"/>
                        </body>
                        <body name="finger_right" pos="0 -0.01 0.05" quat="0.995004 0.0998334 0 0">
                            <inertial pos="0 0.00292064 0.029408" quat="0.995004 -0.0998334 0 0" mass="0.2" diaginertia="0.000151224 0.000147198 1.00259e-05"/>
                            <joint name="right" damping="0.01" pos="0 0 0" axis="-1 0 0" range="-0.5 0.085" actuatorfrcrange="-5 5"/>
                            <geom size="0.005 0.015" pos="0 0 0.015" type="cylinder"/>
                            <geom size="0.005 0.015" pos="0 0.00584128 0.0438159" quat="0.980067 -0.198669 0 0" type="cylinder"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="hip" joint="hip" kp="100"/>
        <position name="shoulder" joint="shoulder" kp="125" ctrlrange="-1.5708 0.6981"/>
        <position name="elbow" joint="elbow" kp="125" ctrlrange="-2.25 1"/>
        <position name="wrist" joint="wrist" kp="100" ctrlrange="-1.5708 1.5708"/>
        <position name="left" joint="left" kp="100" ctrlrange="-0.5 0.085"/>
        <position name="right" joint="right" kp="100" ctrlrange="-0.5 0.085"/>
    </actuator>
  
    <sensor>
        <jointpos name="hip" joint="hip"/>
        <jointpos name="shoulder" joint="shoulder"/>
        <jointpos name="elbow" joint="elbow"/>
        <jointpos name="wrist" joint="wrist"/>
        <jointpos name="left" joint="left"/>
        <jointpos name="right" joint="right"/>
    </sensor>



</mujoco>